---
const { href, variant = 'primary', ...rest } = Astro.props;
---
<a href={href} class:list={['btn', variant]} {...rest}><slot /></a>
<style>
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 24px;border-radius:99px;font-weight:600;font-size:1rem;text-decoration:none;transition:transform .15s,box-shadow .15s,background .15s;border:1px solid transparent}
.primary{background:var(--green);color:#fff;box-shadow:0 1px 2px rgba(23,59,48,.3),inset 0 1px 0 rgba(255,255,255,.12)}
.primary:hover{background:var(--green-deep);transform:translateY(-1px);box-shadow:var(--shadow)}
.secondary{background:#fff;color:var(--green-dark);border-color:var(--line)}
.secondary:hover{border-color:var(--sage);background:var(--pistachio)}
.light{background:#fff;color:var(--green-dark)}
.light:hover{background:var(--pistachio)}
</style>
