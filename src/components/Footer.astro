---
const year = new Date().getFullYear();
---
<footer>
  <div class="container grid">
    <div>
      <a href="/" class="brand"><img src="/favicon.svg" width="32" height="32" alt="" />NexaCare</a>
      <p>A calm medication reminder for Android. Reminders stay until you mark the dose. Your medication list stays on your phone.</p>
    </div>
    <nav aria-label="Footer">
      <a href="/">Home</a><a href="/support">Support</a><a href="/privacy-policy">Privacy Policy</a>
    </nav>
  </div>
  <div class="container fine">
    <p>NexaCare does not give medical advice, dosing advice, or a diagnosis. Always follow your clinician's guidance.</p>
    <p>© {year} NexaCare. All rights reserved.</p>
  </div>
</footer>
<style>
footer{background:var(--green-dark);color:#cfdccf;padding:56px 0 28px}
.grid{display:grid;grid-template-columns:2fr 1fr;gap:32px}
.brand{display:flex;align-items:center;gap:10px;color:#fff;font-weight:700;font-size:1.2rem;text-decoration:none;margin-bottom:12px}
p{max-width:46ch;margin:0 0 .6em}
nav{display:flex;flex-direction:column;gap:4px}
nav a{color:#cfdccf;text-decoration:none;padding:8px 0;min-height:44px;display:flex;align-items:center}
nav a:hover{color:#fff;text-decoration:underline}
.fine{margin-top:32px;padding-top:20px;border-top:1px solid rgba(255,255,255,.14);font-size:.9rem;color:#a9bcaa}
@media(max-width:640px){.grid{grid-template-columns:1fr}}
</style>
