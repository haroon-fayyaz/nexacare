---
const { title, icon } = Astro.props;
---
<article class="card">
  <div class="ic" aria-hidden="true" set:html={icon} />
  <h3>{title}</h3>
  <p><slot /></p>
</article>
<style>
.card{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:26px;transition:box-shadow .2s,transform .2s}
.card:hover{box-shadow:var(--shadow);transform:translateY(-2px)}
.ic{width:44px;height:44px;border-radius:12px;background:var(--pistachio);color:var(--green);display:grid;place-items:center;margin-bottom:16px}
.ic :global(svg){width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
p{margin:0;color:var(--text-2);font-size:1rem}
h3{margin-bottom:.4em}
</style>
