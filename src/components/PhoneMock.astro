---
import { u } from '../utils/url';
// Illustrative recreation of the Home screen UI (no real user data).
---
<div class="phone" role="img" aria-label="Illustration of the NexaCare Home screen showing today's progress and a list of doses">
  <div class="screen">
    <div class="top"><span class="logo"><img src={u("/favicon.svg")} width="20" height="20" alt="" />NexaCare</span><span class="bell"></span></div>
    <h4>Good morning</h4>
    <p class="sub">You're on track today.</p>
    <div class="prog"><div class="ring"><b>2</b><small>/ 3</small></div><div><strong>Today's progress</strong><span>2 of 3 doses completed</span></div></div>
    <p class="lbl">Up next</p>
    <div class="dose"><div><small>8:00 PM</small><strong>Sample medication</strong><small>Tablet · 1</small></div><span class="pill up">Upcoming</span></div>
    <p class="lbl">Completed</p>
    <div class="dose done"><div><small>8:00 AM</small><strong>Sample medication</strong></div><span class="pill ok">✓ Taken</span></div>
    <div class="tabs"><i class="on"></i><i></i><b>+</b><i></i><i></i></div>
  </div>
</div>
<style>
.phone{width:290px;max-width:100%;aspect-ratio:9/18.5;background:#111;border-radius:42px;padding:9px;box-shadow:var(--shadow-lg);margin-inline:auto}
.screen{background:var(--ivory);border-radius:34px;height:100%;padding:18px 16px 0;position:relative;overflow:hidden;font-size:12px;line-height:1.35}
.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.logo{display:flex;gap:6px;align-items:center;font-weight:700;color:var(--green-dark);font-size:13px}
.bell{width:16px;height:16px;border:2px solid var(--muted);border-radius:8px 8px 3px 3px}
h4{font-size:24px;margin:0;color:var(--text);letter-spacing:-.02em}
.sub{color:var(--green);font-size:13px;margin:2px 0 12px}
.prog{display:flex;gap:12px;align-items:center;background:var(--pistachio);border-radius:18px;padding:14px;margin-bottom:12px}
.prog strong{display:block;font-size:13px}.prog span{color:var(--muted)}
.ring{width:54px;height:54px;border-radius:50%;background:conic-gradient(var(--green) 0 240deg,#fff 240deg);display:grid;place-items:center;position:relative;flex:none}
.ring::before{content:'';position:absolute;inset:6px;background:var(--pistachio);border-radius:50%}
.ring b,.ring small{position:relative;line-height:1}.ring{grid-auto-flow:row;align-content:center}
.ring b{font-size:15px}.ring small{font-size:9px;color:var(--muted)}
.lbl{font-weight:700;color:var(--muted);margin:10px 0 6px;font-size:12px}
.dose{display:flex;justify-content:space-between;align-items:center;gap:8px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:10px 12px}
.dose small{display:block;color:var(--muted);font-size:10px}.dose strong{font-size:12px}
.done{background:transparent;border-color:transparent;padding-inline:0}
.pill{font-size:10px;font-weight:600;padding:5px 10px;border-radius:99px;white-space:nowrap}
.up{background:var(--up-bg);color:var(--up)}.ok{background:var(--taken-bg);color:var(--taken)}
.tabs{position:absolute;left:0;right:0;bottom:0;height:54px;background:#fff;border-top:1px solid var(--line);display:flex;justify-content:space-around;align-items:center}
.tabs i{width:22px;height:22px;border-radius:6px;background:var(--line)}.tabs i.on{background:var(--green)}
.tabs b{width:38px;height:38px;border-radius:50%;background:var(--green);color:#fff;display:grid;place-items:center;font-size:20px;margin-top:-18px}
</style>
