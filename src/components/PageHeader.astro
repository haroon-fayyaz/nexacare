---
const { eyebrow, title, lead } = Astro.props;
---
<section class="ph"><div class="container">
  <span class="eyebrow">{eyebrow}</span>
  <h1>{title}</h1>
  <p class="lead">{lead}</p>
  <slot />
</div></section>
<style>
.ph{padding:clamp(48px,8vw,88px) 0 clamp(32px,5vw,56px);background:linear-gradient(180deg,var(--pistachio),var(--ivory))}
h1{font-size:clamp(2.1rem,5vw,3.2rem)}
</style>
