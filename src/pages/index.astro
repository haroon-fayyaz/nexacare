---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/Button.astro';
import FeatureCard from '../components/FeatureCard.astro';
import PhoneMock from '../components/PhoneMock.astro';
import CTA from '../components/CTA.astro';
const i = (d: string) => `<svg viewBox="0 0 24 24">${d}</svg>`;
const features = [
  ['Reminders that stay', 'A reminder stays on screen until you mark the dose taken, skipped, or snoozed. Delivery alone never counts as taken.', i('<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10 21a2 2 0 0 0 4 0"/>')],
  ['Reminder health check', 'See whether this phone is ready to deliver the next reminder, and fix notification or alarm settings from inside the app.', i('<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.500-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>')],
  ['Flexible schedules', 'Daily times, selected weekdays, every few days, or on/off weeks, with optional start and end dates. As-needed doses are supported too.', i('<rect x="3" y="5" width="18" height="16" rx="3"/><path d="M8 3v4M16 3v4M3 10h18"/>')],
  ['Interaction and duplicate flags', 'When you add a medication, NexaCare can flag some common, well-known interactions and duplicates as general information. It never blocks saving.', i('<path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9L2.4 18a2 2 0 0 0 1.7 3h15.800a2 2 0 0 0 1.700-3L13.700 3.900a2 2 0 0 0-3.400 0z"/>')],
  ['Scan a label', 'Fill in the Add medication form faster by scanning a label with text recognition or a barcode.', i('<path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3M4 12h16"/>')],
  ['Refill tracking', 'Keep track of how much you have left so a refill does not catch you off guard.', i('<path d="M3 12a9 9 0 0 1 15.500-6.200L21 8M21 3v5h-5M21 12a9 9 0 0 1-15.500 6.200L3 16M3 21v-5h5"/>')],
  ['History and exports', 'See what was taken, skipped, or missed. Counts only, not a score. Export CSV or PDF, or save an encrypted backup.', i('<path d="M3 12a9 9 0 1 0 3-6.700L3 8M3 3v5h5M12 7v5l3 2"/>')],
  ['Optional caregiver alerts', 'Invite one person to hear when a dose window passes without a confirmation. You choose the delay and what is shared, and can revoke at any time.', i('<circle cx="9" cy="8" r="3.500"/><path d="M2.500 20a6.500 6.500 0 0 1 13 0M17 11a3 3 0 1 0 0-6M21.500 20a6.500 6.500 0 0 0-4-6"/>')],
  ['Widget and Wear OS', 'Glance at doses from your home screen with the widget, or on your wrist with Wear OS support.', i('<rect x="7" y="2" width="10" height="20" rx="3"/><path d="M11 18h2"/>')],
];
const steps = [
  ['Add a medication', 'Enter a name and the times you take it, or scan the label to pre-fill the form.'],
  ['Get gentle reminders', 'Choose daily, weekday, or every-few-days schedules. Reminders stay until you act.'],
  ['Mark it and move on', 'Tap taken, skipped, or snooze. Your history keeps a simple log you can export.'],
];
const benefits = [
  ['Private by default', 'Your medication list lives in an encrypted database on your phone and is excluded from Android backup.'],
  ['Calm, not guilt-based', 'No streaks or scores. Missed doses are shown plainly, without judgment.'],
  ['Honest about reliability', 'If this phone may deliver reminders late, the app tells you and helps you fix it.'],
  ['Built to be accessible', 'Light and dark themes, large text support, and status shown with icons and words, never color alone.'],
];
---
<MainLayout title="NexaCare" description="NexaCare is a calm medication reminder for Android. Reminders stay until you mark the dose, and your medication list stays on your phone.">
  <section class="hero">
    <div class="container hgrid">
      <div>
        <span class="eyebrow">Medication reminder for Android</span>
        <h1>Reminders that stay until the dose is done.</h1>
        <p class="lead">NexaCare keeps a reminder on screen until you mark it taken, skipped, or snoozed, and shows you whether your phone is ready to deliver the next one.</p>
        <div class="actions">
          <Button href="#features">Explore features</Button>
          <Button href="/support" variant="secondary">Get help</Button>
        </div>
        <p class="note">Your medication list stays on your phone.</p>
      </div>
      <PhoneMock />
    </div>
  </section>

  <section class="section" id="features">
    <div class="container">
      <div class="center head"><span class="eyebrow">Features</span><h2>Everything a routine needs. Nothing it doesn't.</h2><p class="lead">Built around one promise: you will know when it is time, and what happened.</p></div>
      <div class="grid3">{features.map(([t, d, ic]) => <FeatureCard title={t} icon={ic}>{d}</FeatureCard>)}</div>
    </div>
  </section>

  <section class="section alt" id="how">
    <div class="container">
      <div class="center head"><span class="eyebrow">How it works</span><h2>Set up in three steps.</h2></div>
      <ol class="steps">{steps.map(([t, d], n) => <li><span class="num">{n + 1}</span><h3>{t}</h3><p>{d}</p></li>)}</ol>
    </div>
  </section>

  <section class="section" id="showcase">
    <div class="container show">
      <div>
        <span class="eyebrow">Product</span>
        <h2>Today at a glance.</h2>
        <p class="lead">The Home tab shows your progress, what is up next, and what is already done. A banner appears only when reminders need a quick check.</p>
        <ul class="ticks"><li>Progress ring for today's doses</li><li>Status shown with text and icon</li><li>Main tabs: Home, Schedule, Add, History, Profile</li></ul>
      </div>
      <PhoneMock />
    </div>
  </section>

  <section class="section alt" id="benefits">
    <div class="container">
      <div class="center head"><span class="eyebrow">Why NexaCare</span><h2>Designed to be trusted.</h2></div>
      <div class="grid2">{benefits.map(([t, d]) => <div class="ben"><h3>{t}</h3><p>{d}</p></div>)}</div>
    </div>
  </section>

  <CTA title="A calmer way to stay on schedule." text="NexaCare reminds and keeps a log. It does not give medical advice, dosing advice, or a diagnosis." >
    <Button href="/support" variant="light">Read the support guide</Button>
  </CTA>
</MainLayout>
<style>
.hero{padding:clamp(40px,7vw,88px) 0 clamp(48px,8vw,96px);background:radial-gradient(900px 420px at 80% 0,var(--pistachio),transparent 70%)}
.hgrid{display:grid;grid-template-columns:1.2fr 1fr;gap:48px;align-items:center}
.actions{display:flex;gap:12px;flex-wrap:wrap;margin:28px 0 16px}
.note{color:var(--muted);font-size:.95rem}
.head{margin-bottom:48px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
.alt{background:var(--pistachio)}
.steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.steps li{background:#fff;border-radius:var(--r);padding:28px;border:1px solid var(--line)}
.steps p{margin:0;color:var(--text-2)}
.num{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--green);color:#fff;font-weight:700;margin-bottom:16px}
.show{display:grid;grid-template-columns:1.1fr 1fr;gap:56px;align-items:center}
.ticks{list-style:none;padding:0;margin:20px 0 0;display:grid;gap:10px}
.ticks li{padding-left:30px;position:relative}
.ticks li::before{content:'✓';position:absolute;left:0;color:var(--green);font-weight:700}
.ben{background:#fff;border-radius:var(--r);padding:28px;border:1px solid var(--line)}
.ben p{margin:0;color:var(--text-2)}
@media(max-width:900px){.hgrid,.show{grid-template-columns:1fr;gap:40px}.grid3,.steps{grid-template-columns:1fr 1fr}}
@media(max-width:620px){.grid3,.steps,.grid2{grid-template-columns:1fr}.actions :global(.btn){flex:1 1 100%}}
</style>
